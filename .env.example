# ─── App ──────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# OAuth Providers (optional — remove if not using)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Shift4 Terminal (UTG — card-present) ─────────────────────────────────────
# These require a merchant account from Shift4. Contact Shift4 support to obtain.
SHIFT4_CLIENT_GUID="your-client-guid"
SHIFT4_AUTH_TOKEN="your-auth-token"
# URL of the locally-installed UTG service at the studio (default port 9001)
SHIFT4_UTG_ENDPOINT="http://localhost:9001/UTGProxy"
# Set to "true" to use mocked Shift4 responses (for development)
SHIFT4_MOCK_MODE="true"

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="bookings@yourpottery.co.uk"
RESEND_FROM_NAME="Your Pottery Barn"

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM_NUMBER="+44..."

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STUDIO_NAME="Your Pottery Barn"
NEXT_PUBLIC_STUDIO_PHONE="+44 XXXX XXXXXX"
NEXT_PUBLIC_STUDIO_EMAIL="hello@yourpottery.co.uk"
NEXT_PUBLIC_STUDIO_ADDRESS="Your Studio Address, City, Postcode"

# Default deposit percentage (25 = 25% deposit required online)
BOOKING_DEPOSIT_PERCENTAGE="25"
# Set to "full" to require full payment online, "deposit" for deposit-only
BOOKING_PAYMENT_MODE="deposit"
